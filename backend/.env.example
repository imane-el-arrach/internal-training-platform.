# PostgreSQL : les valeurs sont utilisées par Docker Compose et par l'API locale.
POSTGRES_USER=exia_user
POSTGRES_PASSWORD=changez_ce_mot_de_passe
POSTGRES_DB=exia_academy
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Sécurité JWT : générez une valeur longue et aléatoire pour chaque installation.
SECRET_KEY=remplacez_par_une_valeur_longue_et_aleatoire
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Développement local
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
PUBLIC_CERTIFICATE_URL=http://localhost:5173/certificats

# Fichiers téléversés
UPLOAD_DIR=uploads
TAILLE_MAX_FICHIER_MO=200

# Assistant IA : laissez vide si cette fonctionnalité ne doit pas être utilisée.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
